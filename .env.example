# Ariadne Thread environment example
# Public template only. Put live values in .env, which is ignored by git.

# App runtime
ARIADNE_ENV=development
ARIADNE_WORKSPACE=default
HOST=127.0.0.1
PORT=9621
PUBLIC_APP_NAME=Ariadne Thread

# Local project paths
ARIADNE_STATE_DIR=.ariadne
ARIADNE_INPUT_DIR=inputs
ARIADNE_ARTIFACT_DIR=artifacts
ARIADNE_EXPORT_DIR=exports

# AI provider keys
XAI_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# AI model defaults
DEFAULT_LLM_PROVIDER=xai
REASONING_LLM_MODEL=grok-4.3
DAILY_LLM_MODEL=
LLM_MODEL_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=120

# Local model routing
OLLAMA_HOST=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_DAILY_MODEL=qwen3.5:9b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Embeddings
DEFAULT_EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TIMEOUT=120

# Capture research and public data APIs
FIRECRAWL_API_KEY=
SAM_GOV_API_KEY=
SAM_GOV_API_BASE_URL=https://api.sam.gov
USASPENDING_API_BASE_URL=https://api.usaspending.gov/api/v2
BLS_API_KEY=
BLS_API_BASE_URL=https://api.bls.gov/publicAPI/v2

# MCP tool integration
MCP_CONFIG_PATH=config/mcp.json
MCP_TOOL_TIMEOUT_SECONDS=60

# HTTP defaults for research connectors
HTTP_USER_AGENT=AriadneThread/0.1
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=2
