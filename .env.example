# Ariadne Thread environment example
# Copy this file to .env for local development, then fill in private values.
# Keep .env private. Commit only this example file with safe placeholders.

# =============================================================================
# APP RUNTIME
# =============================================================================

# ARIADNE_ENV: Names the runtime mode. Use "development" on your laptop.
# Future values may include "test" or "production" when deployment exists.
ARIADNE_ENV=development

# ARIADNE_WORKSPACE: A short local workspace name for this operator's capture work.
# Keep it lowercase and simple because it may become part of local folder names.
ARIADNE_WORKSPACE=default

# HOST: Network interface for the local app server.
# 127.0.0.1 means only this machine can connect, which is safest for development.
HOST=127.0.0.1

# PORT: Local web app port. Ariadne uses 9622; 9621 is reserved for Project Theseus.
# Override this in your private .env only if Ariadne needs a different port.
PORT=9622

# PUBLIC_APP_NAME: Display name used by the UI and browser metadata.
PUBLIC_APP_NAME=Ariadne Thread

# =============================================================================
# LOCAL PROJECT PATHS
# =============================================================================

# ARIADNE_STATE_DIR: Private local state owned by the app.
# This can hold indexes, cache files, working memory, and runtime metadata later.
ARIADNE_STATE_DIR=.ariadne

# ARIADNE_EVIDENCE_DIR: Local-first storage for traceable Evidence Items.
# Keep this private because it can include opportunity notes, source excerpts, and analysis.
ARIADNE_EVIDENCE_DIR=.ariadne/evidence

# ARIADNE_DOCUMENT_INTAKE_DIR: Local-first storage for Document Intake Queue
# records, extraction provenance, review state, and accepted-evidence links.
# Keep this private because uploaded source material metadata may be sensitive.
ARIADNE_DOCUMENT_INTAKE_DIR=.ariadne/document-intake

# ARIADNE_PIID_PROFILES_DIR: Local-first storage for structured PIID Contract
# Intelligence Profiles created from USAspending lookups. Keep this private because
# profiles can contain contract numbers, award baselines, and capture research pivots.
ARIADNE_PIID_PROFILES_DIR=.ariadne/piid-profiles

# ARIADNE_SAM_GOV_PROFILES_DIR: Local-first storage for SAM.gov Enrichment
# Profiles created from entity, opportunity, discovery, and attachment workflows.
# Keep this private because profiles can contain capture research pivots and notes.
ARIADNE_SAM_GOV_PROFILES_DIR=.ariadne/sam-gov-profiles

# ARIADNE_CAPABILITY_RUNS_DIR: Local-first storage for Capability Runs,
# reviewable Capability Run Outputs, provenance, and review state. Keep this
# private because run records can include capture workflow context and gaps.
ARIADNE_CAPABILITY_RUNS_DIR=.ariadne/capability-runs

# ARIADNE_NEXT_ACTION_RECOMMENDATIONS_DIR: Local-first storage for reviewable
# Next Action Recommendations generated from Knowledge Context. Keep this
# private because snapshots can include opportunity refs, capability routes,
# review decisions, and created Action Plan links.
ARIADNE_NEXT_ACTION_RECOMMENDATIONS_DIR=.ariadne/next-action-recommendations

# ARIADNE_REFERENCE_WIKI_DIR: Commit-safe background capture knowledge used for
# lightweight Quick Capture influence retrieval. The default points at the imported
# Project Ariadne public-source reference corpus and is safe for local development.
ARIADNE_REFERENCE_WIKI_DIR=docs/reference/project-ariadne/knowledge

# ARIADNE_INPUT_DIR: Drop-zone folder for source material such as RFPs,
# amendments, notes, capture research, customer docs, and draft artifacts.
ARIADNE_INPUT_DIR=inputs

# ARIADNE_ARTIFACT_DIR: Working folder for generated intermediate artifacts.
# Use this for drafts/previews that are not ready to export yet.
ARIADNE_ARTIFACT_DIR=artifacts

# ARIADNE_EXPORT_DIR: Output folder for user-ready files such as DOCX, XLSX,
# slide decks, markdown briefs, and exported capture-plan snapshots.
ARIADNE_EXPORT_DIR=exports

# ARIADNE_TEMPLATE_DIR: Private local folder for artifact templates and export profiles.
# Use this for organization-specific formats that should not be committed to git.
ARIADNE_TEMPLATE_DIR=.ariadne/templates

# ARIADNE_OBSIDIAN_VAULT_DIR: Optional path to a private Obsidian vault mirror.
# Leave blank unless you want Ariadne to export readable markdown knowledge notes.
ARIADNE_OBSIDIAN_VAULT_DIR=

# =============================================================================
# AI PROVIDER KEYS
# =============================================================================

# XAI_API_KEY: Optional xAI key for Grok reasoning models.
# Create one at https://console.x.ai and paste only into your private .env.
XAI_API_KEY=

# OPENAI_API_KEY: OpenAI key for Ariadne's canonical embeddings.
# Required once semantic search or knowledge indexing is enabled.
# Create one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# GOOGLE_API_KEY: Optional Google AI key for Gemini models if we add them later.
# Leave blank until a feature specifically needs it.
GOOGLE_API_KEY=

# =============================================================================
# AI MODEL DEFAULTS
# =============================================================================

# DEFAULT_LLM_PROVIDER: Which hosted provider the app should try first.
# Keep as "xai" unless the architecture changes or a feature asks for another one.
DEFAULT_LLM_PROVIDER=xai

# REASONING_LLM_MODEL: Model for hard strategy, analysis, and artifact generation.
# This is a product default, not a guarantee that every workflow will use it.
REASONING_LLM_MODEL=grok-4.3

# DAILY_LLM_MODEL: Optional cheaper/faster hosted model for routine tasks.
# Leave blank until we choose a specific model for daily operations.
DAILY_LLM_MODEL=

# LLM_MODEL_TEMPERATURE: Default creativity/randomness for model calls.
# Lower values are steadier. 0.2 is a good starting point for capture work.
LLM_MODEL_TEMPERATURE=0.2

# LLM_MAX_OUTPUT_TOKENS: Safety cap for long model responses.
# Increase only when workflows genuinely need longer generated artifacts.
LLM_MAX_OUTPUT_TOKENS=8192

# LLM_TIMEOUT_SECONDS: How long the app waits for a hosted model response.
# Larger artifacts and reasoning calls may need more time than short chat replies.
LLM_TIMEOUT_SECONDS=120

# =============================================================================
# LOCAL MODEL DEFAULTS
# =============================================================================

# OLLAMA_HOST: Base URL for the local Ollama service.
# Install Ollama from https://ollama.com if using local models.
OLLAMA_HOST=http://localhost:11434

# OLLAMA_OPENAI_BASE_URL: Ollama's OpenAI-compatible endpoint.
# Some libraries expect this /v1 path instead of the base Ollama host.
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1

# LOCAL_DAILY_MODEL: Local model for quick low-cost tasks once installed in Ollama.
# Change this to match the model you actually pulled locally.
LOCAL_DAILY_MODEL=qwen3.5:9b

# LOCAL_ADMIN_MODEL_ENABLED: Enables optional local-model help for low-risk
# Quick Capture draft support. Default false is safe and requires no Ollama.
# This workflow reuses OLLAMA_HOST and LOCAL_DAILY_MODEL; do not define a separate
# local-admin model or base URL unless a later ADR creates a real second model role.
LOCAL_ADMIN_MODEL_ENABLED=false

# LOCAL_ADMIN_MODEL_TIMEOUT_SECONDS: Max wait for optional local admin assist.
# If Ollama is unavailable or times out, Ariadne falls back to deterministic heuristics.
LOCAL_ADMIN_MODEL_TIMEOUT_SECONDS=30

# =============================================================================
# CANONICAL OPENAI EMBEDDINGS
# =============================================================================

# EMBEDDING_MODEL: One canonical embedding model for Ariadne indexes.
# Do not mix embedding models in one index; dimensions and retrieval behavior differ.
# text-embedding-3-large is the high-quality default for capture documents.
EMBEDDING_MODEL=text-embedding-3-large

# EMBEDDING_DIM: Vector size produced by the embedding model above.
# Keep this aligned with EMBEDDING_MODEL. text-embedding-3-large uses 3072.
EMBEDDING_DIM=3072

# EMBEDDING_TIMEOUT: How long to wait for one embedding request.
EMBEDDING_TIMEOUT=120

# =============================================================================
# CAPTURE RESEARCH AND PUBLIC DATA APIS
# =============================================================================

# FIRECRAWL_API_KEY: Optional key for web research and crawling.
# Create one at https://www.firecrawl.dev when research workflows need it.
FIRECRAWL_API_KEY=

# SAM_GOV_API_KEY: Optional key for SAM.gov opportunity and entity data.
# Create one at https://open.gsa.gov/api/get-started/.
SAM_GOV_API_KEY=

# SAM_GOV_API_BASE_URL: Public SAM.gov API base URL.
# Change only if SAM.gov publishes a new base URL or we use a proxy.
SAM_GOV_API_BASE_URL=https://api.sam.gov

# USASPENDING_API_BASE_URL: Public USAspending API base URL.
# No API key is required for many USAspending endpoints.
USASPENDING_API_BASE_URL=https://api.usaspending.gov/api/v2

# BLS_API_KEY: Optional Bureau of Labor Statistics key.
# Useful for labor, wage, market, staffing, and price-to-win context.
BLS_API_KEY=

# BLS_API_BASE_URL: Public BLS API base URL.
BLS_API_BASE_URL=https://api.bls.gov/publicAPI/v2

# API_DATA_GOV_KEY: Optional shared api.data.gov key.
# Useful for public-data MCPs such as GSA Per Diem and Regulations.gov.
# Create one at https://api.data.gov/signup/.
API_DATA_GOV_KEY=

# PERDIEM_API_KEY: API key used by GSA Per Diem connectors.
# Usually set this to ${API_DATA_GOV_KEY} so one api.data.gov key works everywhere.
PERDIEM_API_KEY=${API_DATA_GOV_KEY}

# =============================================================================
# MCP TOOL INTEGRATION
# =============================================================================

# MCP_CONFIG_PATH: Where Ariadne should look for local MCP server definitions.
# This file does not need to exist until we wire real MCP connectors.
MCP_CONFIG_PATH=config/mcp.json

# MCP_TOOL_TIMEOUT_SECONDS: Maximum time to wait for one MCP tool call.
# Keep this modest so a stuck external tool does not freeze the Command Center.
MCP_TOOL_TIMEOUT_SECONDS=60

# =============================================================================
# HTTP DEFAULTS FOR RESEARCH CONNECTORS
# =============================================================================

# HTTP_USER_AGENT: Identifies Ariadne to public APIs and websites.
# Keep it honest and boring; some services require a clear user agent.
HTTP_USER_AGENT=AriadneThread/0.1

# HTTP_TIMEOUT_SECONDS: Maximum time to wait for one outbound HTTP request.
HTTP_TIMEOUT_SECONDS=60

# HTTP_MAX_RETRIES: How many times to retry transient network failures.
# Use a small number to avoid hammering public APIs.
HTTP_MAX_RETRIES=2
