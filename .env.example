# Ariadne Thread environment example
# Public template only. Put live values in .env, which is ignored by git.

# App and workspace
ARIADNE_ENV=development
ARIADNE_WORKSPACE=default
HOST=127.0.0.1
PORT=9621
WEBUI_TITLE=Ariadne Thread
WEBUI_DESCRIPTION=Capture Command Center
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs

# Provider API keys
XAI_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=

# Primary LLM routing
LLM_PROVIDER=xai
LLM_BASE_URL=https://api.x.ai/v1
REASONING_LLM_MODEL=grok-4.3
FAST_LLM_MODEL=
EXTRACT_LLM_MODEL=
QUERY_LLM_MODEL=
KEYWORD_LLM_MODEL=
VLM_LLM_MODEL=
POST_PROCESS_LLM_MODEL=
LLM_MODEL_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=120

# Optional Google model routing
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_MODEL=

# Local model routing
OLLAMA_HOST=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_DAILY_MODEL=qwen3.5:9b
LOCAL_REASONING_MODEL=
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TIMEOUT=120

# LightRAG / RAGAnything compatibility aliases
# Keep blank unless launching those tools directly before Ariadne adapters exist.
LLM_BINDING=
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
EMBEDDING_BINDING=
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=

# Knowledge layer storage
RAG_STORAGE_DIR=./rag_storage
LIGHTRAG_WORKING_DIR=./rag_storage/lightrag
KNOWLEDGE_INPUT_DIR=./inputs
OBSIDIAN_VAULT_DIR=

# Chunking and extraction
CHUNK_SIZE=4000
CHUNK_OVERLAP_SIZE=400
MAX_ASYNC=16
EMBEDDING_FUNC_MAX_ASYNC=8
MAX_PARALLEL_INSERT=4
MAX_GLEANING=0
ENTITY_EXTRACTION_STRICT_SCHEMA=true
ENTITY_TYPE_PROMPT_FILE=prompts/entity_type/govcon.yaml

# RAGAnything context
CONTEXT_WINDOW=2
CONTEXT_MODE=page
CONTENT_FORMAT=markdown
MAX_CONTEXT_TOKENS=6000
INCLUDE_HEADERS=true
INCLUDE_CAPTIONS=true
CONTEXT_FILTER_CONTENT_TYPES=table,image,equation

# MinerU document parsing
PARSER=mineru
PARSE_METHOD=auto
MINERU_BACKEND=pipeline
MINERU_LANG=en
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=false
MINERU_TEMP_DIR=C:\T
CUDA_VISIBLE_DEVICES=0
MINERU_DEVICE_MODE=auto

# Graph storage
GRAPH_STORAGE=NetworkXStorage
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Semantic post-processing
ENABLE_POST_PROCESSING=true
BATCH_TIMEOUT_SECONDS=30

# Hermes agent and skill runtime ceilings
HERMES_MEMORY_DIR=./rag_storage/hermes
SKILL_TOOLS_MAX_TURNS=12
SKILL_TOOLS_LLM_TIMEOUT=120
SKILL_TOOLS_MAX_TOOL_RESULT_CHARS=20000
SKILL_TOOLS_MAX_READ_BYTES=200000
SKILL_TOOLS_MAX_WRITE_BYTES=200000
SKILL_TOOLS_MAX_SCRIPT_SECONDS=120
SKILL_TOOLS_MAX_KG_ENTITIES_PER_TYPE=50
SKILL_TOOLS_MAX_KG_CHUNKS=20
SKILL_TOOLS_MAX_CHUNKS_PER_ENTITY=8
SKILL_TOOLS_MAX_RELATIONSHIPS_PER_ENTITY=50
MCP_HANDSHAKE_TIMEOUT=30
